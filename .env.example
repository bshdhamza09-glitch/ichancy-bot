# Ichancy documented Agent API (keep actual credentials in Railway Variables only)
# The official document gives paths only, NOT a host. Put the host Ichancy gave you for the Agent API.
# Do not assume it equals the cashier panel host. No default is used.
ICHANCY_API_BASE_URL=
ICHANCY_AGENT_ID=2836401
# Per the document, signIn "username" is the AGENT EMAIL.
ICHANCY_AGENT_EMAIL=
ICHANCY_AGENT_PASSWORD=
# Legacy names still accepted: ICHANCY_CASHIER_USERNAME / ICHANCY_CASHIER_PASSWORD
# The document does not state the Authorization header format; Bearer is assumed.
ICHANCY_AUTH_SCHEME=Bearer
# Optional: store on an attached Railway volume; defaults to DATABASE_PATH directory
ICHANCY_TOKEN_PATH=/data/ichancy_agent_tokens.json
